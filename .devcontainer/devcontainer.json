{
  "name": "AWS Examples",

  "build": {
    "context": ".",
    "dockerfile": "Dockerfile"
  },

  "containerEnv": {
    "AWS_DEFAULT_REGION": "us-east-2"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "amazonwebservices.aws-toolkit-vscode",
        "hashicorp.terraform",
        "ms-azuretools.vscode-docker"
      ]
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh"
}

